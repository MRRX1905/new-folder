# apps/api
# Salin ke .env. Jangan commit file .env.
# Semua nilai di file ini hanya untuk server. Tidak ada yang boleh masuk bundle web.

NODE_ENV=development
PORT=4000
TRUST_PROXY=1
LOG_LEVEL=info

# PostgreSQL 16 (Railway). Produksi: tambahkan sslmode=require.
DATABASE_URL=postgresql://rf:change-me@localhost:5432/rf?schema=public

# HMAC reauthToken 5 menit untuk restore. Cookie rf_sess tidak ditandatangani;
# token 32 byte acak + SHA-256 (TD-06).
SESSION_SECRET=replace-with-32-byte-random-hex

# Origin web persis, tanpa trailing slash. CORS + CSRF allowlist.
FRONTEND_ORIGIN=http://localhost:5173

# Seed awal saja. Hapus dari environment setelah Admin dibuat.
ADMIN_USERNAME=rf-admin
ADMIN_PASSWORD=replace-with-strong-password

# Cloudinary — server only. Aplikasi tidak pernah memanggil Destroy API.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# SMTP — default Resend (TD-12). MAIL_FROM wajib di domain SPF + DKIM.
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USER=resend
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=no-reply@example.com
ADMIN_EMAIL=admin@example.com

# reCAPTCHA v2 — verifikasi server-side.
RECAPTCHA_SECRET_KEY=replace-with-recaptcha-secret-key

# DeepL API Free via proxy backend (TD-04).
DEEPL_API_KEY=replace-with-deepl-key
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Vercel Deploy Hook — dipicu jobs/deploy-hook.ts, debounce 5 menit (TD-11).
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/replace-me
