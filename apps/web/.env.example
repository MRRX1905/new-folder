# apps/web — Vite
# Salin ke .env.local. Semua nilai di sini terekspos ke browser.
# Hanya variabel VITE_* yang boleh ada di file ini. Jangan menaruh secret.

# Base URL API termasuk prefix /api/v1. Wajib HTTPS di production.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Origin publik web. Dipakai canonical, Open Graph, dan prerender.
VITE_SITE_URL=http://localhost:5173

# reCAPTCHA v2 checkbox — site key publik, bukan secret key.
VITE_RECAPTCHA_SITE_KEY=replace-with-recaptcha-v2-site-key
